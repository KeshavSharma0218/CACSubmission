# Local development environment (for non-Docker runs)
# For Docker, DATABASE_URL is overridden in docker-compose.local.yml

ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://safewalk:safewalk@localhost:5433/safewalk
JWT_SECRET_KEY=dev-local-secret-change-in-production
MAX_ROUTE_ALTERNATIVES=3
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_PROFILE=foot
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=SafeWalk/0.1 (contact: dev@localhost)
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
WEATHER_PROVIDER=nws
AIR_QUALITY_PROVIDER=openaq
TRANSIT_PROVIDER=transitland
CIVIC_DATA_PROVIDER=none
FLOOD_PROVIDER=fema
CRIME_DATA_PROVIDER=
CORS_ALLOW_ORIGINS=["*"]
